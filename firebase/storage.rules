rules_version = '2';

// 증빙 파일/프로젝트 이미지는 공개 읽기, 업로드는 관리자(admin claim)만.
service firebase.storage {
  match /b/{bucket}/o {
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
