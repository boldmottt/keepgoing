# Firebase Web SDK 설정. 값이 없으면 web/lib/mockData.ts 의 더미 데이터로 동작합니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 데이터 소스 지정.
#   mock      (기본값) — web/lib/mockData.ts 의 더미 데이터로 동작. 자격증명 없이 정적 빌드 가능.
#   firestore — 위 NEXT_PUBLIC_FIREBASE_* 설정이 모두 채워졌을 때 Cloud Firestore 에서 읽기.
#               (env 누락이나 읽기 실패 시 자동으로 mock 으로 폴백)
# 비우거나 잘못된 값이면 mock 으로 동작합니다.
NEXT_PUBLIC_DATA_SOURCE=mock
